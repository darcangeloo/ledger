{
  "name": "ledger",
  "version": "1.0.0",
  "private": true,
  "description": "Bundle locali del frontend di Ledger (Editor.js, Mermaid). Nessun CDN.",
  "scripts": {
    "build": "esbuild frontend/editor.js --bundle --outfile=frontend/editor.bundle.js --format=iife && esbuild frontend/mermaid_view.js --bundle --outfile=frontend/mermaid_view.bundle.js --format=iife",
    "test": "python -m unittest discover -s tests -v"
  },
  "keywords": ["notes", "journal", "offline", "encrypted", "pywebview"],
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@editorjs/checklist": "^1.6.0",
    "@editorjs/code": "^2.9.4",
    "@editorjs/delimiter": "^1.4.2",
    "@editorjs/editorjs": "^2.31.6",
    "@editorjs/header": "^2.8.9",
    "@editorjs/inline-code": "^1.5.2",
    "@editorjs/list": "^2.0.9",
    "@editorjs/marker": "^1.4.0",
    "@editorjs/quote": "^2.7.6",
    "@editorjs/table": "^2.4.5",
    "mermaid": "^11.16.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
